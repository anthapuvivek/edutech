# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/learntrix
DB_USERNAME=postgres
DB_PASSWORD=change-me-local-postgres-password

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-key-minimum-32-characters-long
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_REMEMBER_ME_EXPIRATION=2592000000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Mail / SMTP Configuration
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
APP_CLIENT_URL=http://localhost:8080

# Frontend Configuration (for reference)
VITE_API_URL=http://localhost:8081/api
VITE_APP_URL=http://localhost:8080
VITE_CDN_URL=
VITE_USE_MOCKS=false

# ---------------------------------------------------------------------------
# Outbound email (SMTP)
# ---------------------------------------------------------------------------
# Leave MAIL_HOST empty and NOTHING is sent - the activation link is only written
# to the backend log and the admin UI reports emailStatus=NOT_CONFIGURED.
#
# Gmail: MAIL_PASSWORD must be a 16-character *App Password* generated at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# A normal Gmail account password will be rejected with
# "535-5.7.8 Username and Password not accepted".
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# From header shown to recipients. Gmail rewrites this to MAIL_USERNAME unless the
# address is a verified alias on the account.
MAIL_FROM=your.address@gmail.com
MAIL_FROM_NAME=LearntriX Platform

# Origin used to build activation / reset links inside emails. Must be where the
# frontend actually runs, otherwise recipients get a dead link.
APP_CLIENT_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# AWS (prod profile only: SPRING_PROFILES_ACTIVE=prod)
# ---------------------------------------------------------------------------
# VideoStorageConfig switches between LocalVideoStorageService and
# S3VideoStorageService on this value. Fargate task storage is ephemeral, so
# anything other than s3 loses uploads on every redeploy.
VIDEO_STORAGE=s3
# Required in prod - the app will refuse to start without it, by design.
AWS_S3_BUCKET=learntrix-videos
AWS_S3_REGION=us-east-1
# Optional: CloudFront distribution domain used to build public video URLs.
AWS_CLOUDFRONT_DOMAIN=
#
# Do NOT set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY on ECS. Attach an IAM
# task role instead - the AWS SDK default credentials provider picks it up
# automatically and nothing long-lived is stored in the task definition.

# ---------------------------------------------------------------------------
# Judge0 - code execution for Coding Practice
# ---------------------------------------------------------------------------
# Leave JUDGE0_URL blank and the coding pages still load; Run and Submit report
# that execution is not configured rather than erroring out.
#
# Hosted (RapidAPI):  https://judge0-ce.p.rapidapi.com  + a JUDGE0_API_KEY
# Self-hosted:        http://<host>:2358              + no key needed
#
# This key is read only by the backend and is never sent to the browser.
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# ---------------------------------------------------------------------------
# Google Gemini - AI Question Assistant
# ---------------------------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey and put the real value in
# backend/.env (gitignored) - never here, and never in application.yml.
#
# Blank is fine: the app starts and the assistant reports it is not configured.
GEMINI_API_KEY=
# Verify a model exists before pinning it; new models are often overloaded.
GEMINI_MODEL=gemini-3-flash-preview

# ---------------------------------------------------------------------------
# Code execution provider: judge0 (default) or jdoodle
# ---------------------------------------------------------------------------
EXECUTION_PROVIDER=judge0

# Only needed when EXECUTION_PROVIDER=jdoodle. Get these from your JDoodle
# account. Backend-only - never expose them to the frontend.
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
# Position in JDoodle's version list, not a version number. 0 = oldest/safe.
JDOODLE_VERSION_INDEX=0
