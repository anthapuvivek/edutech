# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/learntrix
DB_USERNAME=postgres
DB_PASSWORD=@Reddy01

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-key-minimum-32-characters-long
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_REMEMBER_ME_EXPIRATION=2592000000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Mail / SMTP Configuration
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
APP_CLIENT_URL=http://localhost:8080

# Frontend Configuration (for reference)
VITE_API_URL=http://localhost:8081/api
VITE_APP_URL=http://localhost:8080
VITE_CDN_URL=
VITE_USE_MOCKS=false

# ---------------------------------------------------------------------------
# Outbound email (SMTP)
# ---------------------------------------------------------------------------
# Leave MAIL_HOST empty and NOTHING is sent - the activation link is only written
# to the backend log and the admin UI reports emailStatus=NOT_CONFIGURED.
#
# Gmail: MAIL_PASSWORD must be a 16-character *App Password* generated at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# A normal Gmail account password will be rejected with
# "535-5.7.8 Username and Password not accepted".
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# From header shown to recipients. Gmail rewrites this to MAIL_USERNAME unless the
# address is a verified alias on the account.
MAIL_FROM=your.address@gmail.com
MAIL_FROM_NAME=LearntriX Platform

# Origin used to build activation / reset links inside emails. Must be where the
# frontend actually runs, otherwise recipients get a dead link.
APP_CLIENT_URL=http://localhost:8080
