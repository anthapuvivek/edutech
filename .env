# Frontend runtime config. Only non-secret values belong here — Vite inlines them
# into the client bundle. Secrets live exclusively on the backend.

# false = talk to the Spring Boot API; true = run entirely on src/mock fixtures.
VITE_USE_MOCKS=false

# Backend origin. server.port in backend/src/main/resources/application.yml is 8081.
VITE_API_URL=http://localhost:8081/api

# This app's own origin, used to build links in verification and password-reset emails.
# The Vite dev server runs on 8080 (see CORS_ALLOWED_ORIGINS on the backend).
VITE_APP_URL=http://localhost:8080

VITE_CDN_URL=
